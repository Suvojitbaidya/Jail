// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String
  role           Role     @default(USER)
  // Reverse relations
  ownedCameras   Camera[] @relation("CameraOwner")
  createdCameras Camera[] @relation("CameraCreatedBy")
  updatedCameras Camera[] @relation("CameraUpdatedBy")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Camera {
  id        Int          @id @default(autoincrement())
  name      String
  location  Location
  ipAddress String? // Nullable
  port      Int? // Nullable
  type      CameraType
  protocol  String? // Nullable
  status    CameraStatus
  userId    Int
  user      User         @relation("CameraOwner", fields: [userId], references: [id])

  createdById Int
  createdBy   User @relation("CameraCreatedBy", fields: [createdById], references: [id])

  updatedById Int
  updatedBy   User @relation("CameraUpdatedBy", fields: [updatedById], references: [id])

  heightThreshold Float? // Nullable
  alertThreshold  Float   @default(5) // Default value 5
  cameraUrl       String? // Nullable new field

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Alert     Alert[]
}

model Alert {
  id       Int    @id @default(autoincrement())
  cameraId Int
  camera   Camera @relation(fields: [cameraId], references: [id])

  type               AlertType // Enum: 'height', 'count'
  noOfPeople         Int
  url                String?
  createdAt          DateTime    @default(now())
  isVisited          Boolean? // Optional
  status             AlertStatus @default(ACTIVE)
  isNotificationSent Boolean     @default(true)
  notificationSentAt DateTime? // Optional
}

enum Role {
  ADMIN
  USER
}

enum Location {
  wallside
  normal
}

enum CameraType {
  camera
  link
}

enum CameraStatus {
  active
  inactive
}

enum AlertType {
  HEIGHT
  COUNT
}

enum AlertStatus {
  ACTIVE
  INACTIVE
}
